{
  "name": "dsh-resume-budget",
  "version": "0.1.0",
  "description": "Resume input budget for DeepSeek Harness: before a restored session re-sends its whole history, check the projection and compact first when it is over the ceiling.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./decision": "./lib/decision.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "dev-link": "scripts/dev-link.sh",
    "check": "scripts/check.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-token-meter": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-compaction": { "optional": true },
    "@deepseek-ai/dsh-token-meter": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "compaction",
    "resume",
    "budget",
    "plugin"
  ],
  "license": "MIT"
}
